# Copy to .env.local and fill in (Supabase dashboard > Project Settings > API). The anon key is safe to ship in the
# browser because Row Level Security (supabase/schema.sql) protects the data. Never put the service_role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Optional: public URL of the deployed site, used for share-preview tags. Example: https://you.github.io/dungeon-of-data-react/
VITE_SITE_URL=
# Optional: GoatCounter site code (privacy-friendly analytics, no cookies). Example: dungeon-of-data
VITE_GOATCOUNTER=
